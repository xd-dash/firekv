{
  "name": "firekv-tfstate-durable",
  "main": "durable-worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "TFSTATE_DURABLE", "class_name": "TerraformState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TerraformState"] }
  ],
  "vars": {
    "STATE_HOST": "tfstate.firekv.dashxd.com",
    "STATE_SCOPE": "cloudflare/dashxd-dns",
    "OIDC_AUDIENCE": "firekv",
    "GITHUB_REPOSITORY": "xd-dash/huram-abi-master",
    "GITHUB_OWNER": "xd-dash",
    "GITHUB_REF": "refs/heads/codex/smoke-auth-cloudflare-deployment-consolidation",
    "GITHUB_ENVIRONMENT": "cloudflare-terraform"
  }
}
